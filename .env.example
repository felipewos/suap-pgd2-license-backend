# Backend (licença/trial)
PORT=8787
ORIGIN_ALLOWLIST=http://localhost:8787,chrome-extension://*
SUPPORT_REBIND_CODE=SEU-CODIGO-DO-SUPORTE

# Stripe (opcional, para checkout)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Preços (IDs de Price do Stripe) — crie no painel do Stripe
STRIPE_PRICE_BASIC_MONTHLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_BASIC_YEARLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx

# Trial (em dias) — pode alterar sem atualizar extensão
TRIAL_DAYS=7


# Precos (IDs de Price do Stripe) - pagamento unico (Pix)
STRIPE_PRICE_BASIC_MONTHLY_ONETIME=price_xxx
STRIPE_PRICE_PRO_MONTHLY_ONETIME=price_xxx
STRIPE_PRICE_BASIC_YEARLY_ONETIME=price_xxx
STRIPE_PRICE_PRO_YEARLY_ONETIME=price_xxx
